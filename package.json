{
  "name": "quality-gate",
  "version": "0.2.0",
  "private": true,
  "description": "Shared quality gate for OKQ projects: Vite+ base config and a reusable PR report workflow",
  "license": "MIT",
  "author": "Maxime Sahroui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximeshr/quality-gate.git"
  },
  "bin": {
    "quality-gate": "./bin/quality-gate.js"
  },
  "files": [
    "bin",
    "configs",
    "scripts",
    "src"
  ],
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./commitlint": "./configs/commitlint.config.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "jscpd": "5.4.1",
    "knip": "6.42.1",
    "secretlint": "13.0.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
